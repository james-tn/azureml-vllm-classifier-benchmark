# Copy to config.env and fill in. config.env is git-ignored.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-rg
AZUREML_WORKSPACE=my-workspace

# Optional (defaults shown)
# ACR_NAME=                                  # default: the workspace's container registry
# ENDPOINT_NAME=vllm-cls-poc
# DEPLOYMENT_NAME=h100
# INSTANCE_TYPE=Standard_NC40ads_H100_v5
# INSTANCE_COUNT=1
# VLLM_ARGS=--max-model-len 8192 --max-num-batched-tokens 32768
# VLLM_BASE_TAG=v0.32.0-x86_64-cu129
# IMAGE_TAG=v1
# DOCKERFILE=Dockerfile.baked                # Dockerfile.byo to serve your own checkpoint from env/checkpoint/
# MODEL_IN_IMAGE=true
